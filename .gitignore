# =====================================================================
#  rag-local — .gitignore
#  原则:私有运行数据与生成物一律不入库;仅提交源码、脚本与文档
# =====================================================================

# ---------- 私有运行数据(绝不提交) ----------
data/
*.db
*.sqlite3
*.sqlite3-*

# ---------- Python 虚拟环境与缓存 ----------
backend/.venv/
.venv/
.venv-*/                    # 临时/试验用虚拟环境(如 .venv-citest)
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 日志 ----------
*.log
logs/

# ---------- 生成物(可由脚本重建) ----------
# 注意:scripts/demo_docs/ 是「有意入库」的虚构演示语料(克隆后可直接 seed_demo_kbs.py 体验),
# 因此不在此忽略;重新生成后如显示为修改,确认内容无个人/真实企业信息再提交。
htmlcov/
.coverage

# ---------- Office / 临时文件 ----------
~$*
*.tmp
*.bak
*.swp

# ---------- 操作系统 / IDE ----------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.code-workspace

# ---------- 本地配置覆写(含个人路径/模型名) ----------
.env
.env.local
